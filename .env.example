# Copy this file to ".env" and fill in the two values from your Supabase project.
# Supabase dashboard -> Project Settings -> API
#
# If you leave these blank, the app still runs but stores data only in this
# browser (localStorage) with no live sync between devices. Fill them in to
# turn on cloud sync across phone and PC.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
